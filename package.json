{
  "name": "nhhr-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/geo-toolkit"
  ],
  "scripts": {
    "toolkit:build": "node scripts/build-toolkit.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run toolkit:build && tsc --noEmit && vite build && node scripts/prepare-spa-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "data:prepare": "python3 scripts/prepare-nhhr-data.py",
    "data:boundaries": "node scripts/prepare-nhhr-boundaries.mjs",
    "chrome:sync": "node scripts/sync-chrome.mjs"
  },
  "dependencies": {
    "@ahzs645/unbc-logo": "file:packages/unbc-logo",
    "@pgmaps/geo-toolkit": "0.1.0",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.3"
  },
  "overrides": {
    "@loaders.gl/3d-tiles": "4.4.3",
    "@loaders.gl/compression": "4.4.3",
    "@loaders.gl/core": "4.4.3",
    "@loaders.gl/crypto": "4.4.3",
    "@loaders.gl/draco": "4.4.3",
    "@loaders.gl/geoarrow": "4.4.3",
    "@loaders.gl/gis": "4.4.3",
    "@loaders.gl/gltf": "4.4.3",
    "@loaders.gl/images": "4.4.3",
    "@loaders.gl/loader-utils": "4.4.3",
    "@loaders.gl/math": "4.4.3",
    "@loaders.gl/mvt": "4.4.3",
    "@loaders.gl/schema": "4.4.3",
    "@loaders.gl/schema-utils": "4.4.3",
    "@loaders.gl/terrain": "4.4.3",
    "@loaders.gl/textures": "4.4.3",
    "@loaders.gl/tiles": "4.4.3",
    "@loaders.gl/wms": "4.4.3",
    "@loaders.gl/worker-utils": "4.4.3",
    "@loaders.gl/xml": "4.4.3",
    "@loaders.gl/zip": "4.4.3",
    "maplibre-gl": "$maplibre-gl"
  }
}
